      "line": 17,
      "category": "reliability",
      "tags": ["unbounded", "grow", "memory", "eviction", "no limit on the cache", "leak"]
    },
    {
      "file": "app/users.py",
      "line": 34,
      "category": "reliability",
      "tags": ["race", "thread", "concurren", "lock", "mutable module level", "not thread safe"]
    }
  ]
